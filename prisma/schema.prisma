// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// NextAuth.js tables
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// Core application tables
model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  password      String? // For credentials auth
  role          UserRole  @default(EMPLOYEE)
  company       String? // Onlime Network LLC or CallPro LLC
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Relations
  accounts      Account[]
  sessions      Session[]
  employee      Employee?
  auditLogs     AuditLog[]
  createdBy     String?
  createdByUser User?      @relation("UserCreatedBy", fields: [createdBy], references: [id])
  createdUsers  User[]     @relation("UserCreatedBy")

  @@map("users")
}

model Employee {
  id               String           @id @default(cuid())
  employeeId       String           @unique // Internal employee ID
  firstName        String
  lastName         String
  email            String           @unique
  phone            String?
  department       String
  position         String
  manager          String? // Manager's email
  company          String? // Onlime Network LLC or CallPro LLC
  companyId        String?
  isActive         Boolean          @default(true)
  employmentStatus EmploymentStatus @default(FULL_TIME)
  workLocation     WorkLocation     @default(OFFICE)
  startDate        DateTime
  endDate          DateTime?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  // Relations
  userId            String             @unique
  user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  companyRef        Company?           @relation(fields: [companyId], references: [id])
  accessPermissions AccessPermission[]
  accessRequests    AccessRequest[]
  auditLogs         AuditLog[]

  @@map("employees")
}

model Company {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  address     String?
  phone       String?
  email       String?
  website     String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  departments Department[]
  employees   Employee[]

  @@map("companies")
}

model Department {
  id               String   @id @default(cuid())
  name             String
  description      String?
  manager          String? // Primary manager's email
  secondaryManager String? // Secondary/deputy manager's email
  company          String? // Onlime Network LLC or CallPro LLC
  companyId        String?
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  // Relations
  positions       Position[]
  accessTemplates DepartmentAccessTemplate[]

  // Foreign key relation
  companyRef Company? @relation(fields: [companyId], references: [id])

  @@unique([name, company])
  @@map("departments")
}

model Position {
  id           String   @id @default(cuid())
  name         String
  level        String // e.g., "Executive", "Director", "Manager", "Senior", "Engineer", "Specialist", "Intern"
  accessLevel  String? // Access level: "Full", "Read", "Write", "Print", "Admin", "Privilege", "None"
  departmentId String
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Relations
  department Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)

  @@unique([name, departmentId])
  @@map("positions")
}

model System {
  id             String         @id @default(cuid())
  name           String         @unique
  description    String?
  category       SystemCategory
  hasApi         Boolean        @default(false)
  apiEndpoint    String?
  requiresManual Boolean        @default(false)
  isActive       Boolean        @default(true)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  // Relations
  accessPermissions    AccessPermission[]
  accessRequestSystems AccessRequestSystem[]
  apiCredentials       ApiCredential[]
  manualTasks          ManualTask[]
  accessTemplates      DepartmentAccessTemplate[]

  @@map("systems")
}

model Resource {
  id            String         @id @default(cuid())
  name          String
  type          ResourceType
  description   String?
  category      String? // e.g., "Production", "Development", "Testing"
  location      String? // Physical or logical location
  owner         String? // Owner's email
  administrator String? // Admin's email
  status        ResourceStatus @default(ACTIVE)
  isActive      Boolean        @default(true)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@map("resources")
}

model Device {
  id            String       @id @default(cuid())
  name          String
  type          DeviceType
  model         String?
  serialNumber  String?
  macAddress    String?
  ipAddress     String?
  location      String?
  owner         String? // Owner's email
  administrator String? // Admin's email
  status        DeviceStatus @default(ACTIVE)
  isActive      Boolean      @default(true)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@map("devices")
}

model Server {
  id            String       @id @default(cuid())
  name          String
  hostname      String?
  ipAddress     String?
  os            String? // Operating System
  environment   String? // Production, Staging, Development
  location      String?
  administrator String? // Admin's email
  status        ServerStatus @default(ACTIVE)
  isActive      Boolean      @default(true)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@map("servers")
}

model Database {
  id            String         @id @default(cuid())
  name          String
  type          DatabaseType
  host          String?
  port          Int?
  environment   String? // Production, Staging, Development
  administrator String? // Admin's email
  status        DatabaseStatus @default(ACTIVE)
  isActive      Boolean        @default(true)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@map("databases")
}

model AccessPermission {
  id          String    @id @default(cuid())
  employeeId  String
  systemId    String
  accessLevel String // e.g., "Admin", "User", "Read-only", "Full access"
  isActive    Boolean   @default(true)
  grantedBy   String? // User ID who granted access
  grantedAt   DateTime  @default(now())
  expiresAt   DateTime? // NULL for permanent access
  revokedBy   String? // User ID who revoked access
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // Relations
  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  system   System   @relation(fields: [systemId], references: [id], onDelete: Cascade)

  @@unique([employeeId, systemId])
  @@map("access_permissions")
}

model AccessRequest {
  id          String        @id @default(cuid())
  employeeId  String
  requestType RequestType
  status      RequestStatus @default(PENDING)
  title       String
  description String?
  priority    Priority      @default(MEDIUM)
  requestedBy String // User ID who made the request
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  completedAt DateTime?

  // Relations
  employee  Employee              @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  systems   AccessRequestSystem[]
  approvals Approval[]

  @@map("access_requests")
}

model AccessRequestSystem {
  id              String  @id @default(cuid())
  accessRequestId String
  systemId        String
  accessLevel     String
  isRequired      Boolean @default(true)

  // Relations
  accessRequest AccessRequest @relation(fields: [accessRequestId], references: [id], onDelete: Cascade)
  system        System        @relation(fields: [systemId], references: [id], onDelete: Cascade)

  @@unique([accessRequestId, systemId])
  @@map("access_request_systems")
}

model ApprovalWorkflow {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  steps       Json // Array of approval steps with roles and conditions
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("approval_workflows")
}

model Approval {
  id              String         @id @default(cuid())
  accessRequestId String
  approverId      String // User ID of approver
  step            Int // Approval step number
  status          ApprovalStatus @default(PENDING)
  comments        String?
  approvedAt      DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  // Relations
  accessRequest AccessRequest @relation(fields: [accessRequestId], references: [id], onDelete: Cascade)

  @@unique([accessRequestId, approverId, step])
  @@map("approvals")
}

model AuditLog {
  id         String   @id @default(cuid())
  action     String // CREATE, UPDATE, DELETE, APPROVE, REJECT, etc.
  entityType String // User, Employee, AccessPermission, etc.
  entityId   String
  oldValues  Json? // Previous values
  newValues  Json? // New values
  userId     String? // User who performed the action
  employeeId String? // Related employee
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())

  // Relations
  user     User?     @relation(fields: [userId], references: [id])
  employee Employee? @relation(fields: [employeeId], references: [id])

  @@map("audit_logs")
}

model ApiCredential {
  id             String    @id @default(cuid())
  systemId       String
  name           String // Credential name/description
  type           String // API_KEY, OAUTH_TOKEN, etc.
  encryptedValue String // Encrypted credential value
  isActive       Boolean   @default(true)
  expiresAt      DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  // Relations
  system System @relation(fields: [systemId], references: [id], onDelete: Cascade)

  @@map("api_credentials")
}

model EmailTemplate {
  id        String   @id @default(cuid())
  name      String   @unique
  subject   String
  body      String   @db.Text
  variables Json // Available template variables
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("email_templates")
}

model ManualTask {
  id              String     @id @default(cuid())
  systemId        String
  accessRequestId String?
  title           String
  description     String
  status          TaskStatus @default(PENDING)
  assignedTo      String? // User ID assigned to task
  priority        Priority   @default(MEDIUM)
  dueDate         DateTime?
  completedAt     DateTime?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  // Relations
  system System @relation(fields: [systemId], references: [id], onDelete: Cascade)

  @@map("manual_tasks")
}

// Enums
enum UserRole {
  ADMIN
  HR_MANAGER
  DEPARTMENT_MANAGER
  EMPLOYEE
  IT_STAFF
}

enum SystemCategory {
  COMMUNICATION
  PRODUCTIVITY
  DEVELOPMENT
  FINANCE
  MARKETING
  CUSTOMER_SERVICE
  INFRASTRUCTURE
  SUPPORT
  DESIGN
  BUSINESS
  GOVERNMENT
  SECURITY
  OTHER
}

enum EmploymentStatus {
  FULL_TIME
  PART_TIME
  CONTRACT
  TEMPORARY
  SEASONAL
  INTERN
  PROBATIONARY
  ON_LEAVE
  MEDICAL_LEAVE
  PARENTAL_LEAVE
  PERSONAL_LEAVE
  SABBATICAL
  MILITARY_LEAVE
  TERMINATED
  RESIGNED
  RETIRED
  LAID_OFF
  DECEASED
  SUSPENDED
  REMOTE
  ON_NOTICE
  PENDING_START
}

enum WorkLocation {
  OFFICE
  REMOTE
  HYBRID
}

enum RequestType {
  ONBOARDING
  OFFBOARDING
  ACCESS_MODIFICATION
  ACCESS_EXTENSION
  ACCESS_REVOCATION
}

enum RequestStatus {
  PENDING
  IN_PROGRESS
  APPROVED
  REJECTED
  COMPLETED
  CANCELLED
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum TaskStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

// Resource Management Enums
enum ResourceType {
  SOFTWARE
  HARDWARE
  NETWORK
  SECURITY
  STORAGE
  BACKUP
  MONITORING
  OTHER
}

enum ResourceStatus {
  ACTIVE
  INACTIVE
  MAINTENANCE
  DECOMMISSIONED
}

enum DeviceType {
  LAPTOP
  DESKTOP
  MOBILE
  TABLET
  PRINTER
  SCANNER
  NETWORK_EQUIPMENT
  SECURITY_DEVICE
  OTHER
}

enum DeviceStatus {
  ACTIVE
  INACTIVE
  MAINTENANCE
  RETIRED
  LOST
  STOLEN
}

enum ServerStatus {
  ACTIVE
  INACTIVE
  MAINTENANCE
  DECOMMISSIONED
  FAILED
}

enum DatabaseType {
  POSTGRESQL
  MYSQL
  MONGODB
  REDIS
  ELASTICSEARCH
  INFLUXDB
  OTHER
}

enum DatabaseStatus {
  ACTIVE
  INACTIVE
  MAINTENANCE
  DECOMMISSIONED
  FAILED
}

// =======================
// COMPREHENSIVE RESOURCE MANAGEMENT MODELS
// =======================

model ResourceDatabase {
  id               String  @id @default(cuid())
  name             String
  databaseType     String // MySQL, PostgreSQL, MongoDB, etc.
  version          String?
  host             String
  port             Int
  databaseName     String?
  schema           String?
  connectionString String?
  adminUser        String?

  // Security
  isEncrypted    Boolean @default(true)
  encryptionType String?

  // Backup
  backupEnabled   Boolean   @default(true)
  backupFrequency String?
  lastBackupDate  DateTime?

  // Access Control
  owner       String
  environment String // production, staging, development, testing
  accessLevel String // read, write, admin, full
  description String? @db.Text

  // ISO 27001 Compliance tracking fields
  requestedBy           String?
  approvedBy            String?
  approvalDate          DateTime?
  businessJustification String?   @db.Text
  expiryDate            DateTime?
  reviewDate            DateTime?
  accessRequestTicketId String?

  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("resource_databases")
}

model ResourceServer {
  id                    String    @id @default(cuid())
  name                  String
  type                  String // Physical, Virtual, Cloud
  os                    String // Linux, Windows
  environment           String
  ipHostname            String
  accessMethod          String // SSH, RDP, Console
  accessLevel           String
  locationRegion        String?
  ownerDepartment       String?
  status                String    @default("ACTIVE")
  notes                 String?
  purpose               String?
  mfaRequired           Boolean   @default(false)
  vpnRequired           Boolean   @default(false)
  // Common tracking fields
  requestDate           DateTime?
  requestedBy           String?
  approvedBy            String?
  approvalDate          DateTime?
  businessJustification String?
  expiryDate            DateTime?
  accessRequestTicketId String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@map("resource_servers")
}

model SoftwareLicense {
  id                    String    @id @default(cuid())
  softwareName          String
  vendor                String
  licenseType           String // Per User, Per Device, Enterprise
  totalSeats            Int
  assignedSeats         Int       @default(0)
  purchaseDate          DateTime?
  expiryRenewalDate     DateTime?
  cost                  Decimal?  @db.Decimal(10, 2)
  status                String    @default("ACTIVE")
  notes                 String?
  licenseKey            String?   @db.Text
  autoRenewal           Boolean   @default(false)
  // Common tracking fields
  requestDate           DateTime?
  requestedBy           String?
  approvedBy            String?
  approvalDate          DateTime?
  businessJustification String?
  accessRequestTicketId String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@map("software_licenses")
}

model SaaSSubscription {
  id                    String    @id @default(cuid())
  serviceName           String
  category              String // Communication, Productivity, Development
  subscriptionPlan      String
  totalSeats            Int
  usedSeats             Int       @default(0)
  billingCycle          String // Monthly, Yearly
  cost                  Decimal?  @db.Decimal(10, 2)
  renewalDate           DateTime?
  ownerDepartment       String?
  status                String    @default("ACTIVE")
  ssoEnabled            Boolean   @default(false)
  apiAccess             Boolean   @default(false)
  // Common tracking fields
  requestDate           DateTime?
  requestedBy           String?
  approvedBy            String?
  approvalDate          DateTime?
  businessJustification String?
  expiryDate            DateTime?
  accessRequestTicketId String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@map("saas_subscriptions")
}

model ResourceDevice {
  id                    String    @id @default(cuid())
  deviceType            String // Laptop, Desktop, Mobile, Monitor
  makeModel             String
  serialNumber          String?
  assetTag              String?
  operatingSystem       String?
  assignedTo            String? // Employee ID
  assignmentDate        DateTime?
  location              String?
  condition             String?
  purchaseDate          DateTime?
  warrantyExpiry        DateTime?
  status                String    @default("AVAILABLE")
  specifications        String?
  purchaseCost          Decimal?  @db.Decimal(10, 2)
  // Common tracking fields
  requestDate           DateTime?
  requestedBy           String?
  approvedBy            String?
  approvalDate          DateTime?
  businessJustification String?
  accessRequestTicketId String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@map("resource_devices")
}

model CloudAccount {
  id                    String    @id @default(cuid())
  cloudProvider         String // AWS, Azure, GCP
  accountName           String
  accountId             String?
  environment           String
  accessType            String // Console, CLI, API
  permissionLevel       String
  regionAccess          String?
  mfaRequired           Boolean   @default(true)
  ownerDepartment       String?
  status                String    @default("ACTIVE")
  notes                 String?
  costCenter            String?
  servicesAccessible    String?
  // Common tracking fields
  requestDate           DateTime?
  requestedBy           String?
  approvedBy            String?
  approvalDate          DateTime?
  businessJustification String?
  expiryDate            DateTime?
  accessRequestTicketId String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@map("cloud_accounts")
}

model InternalTool {
  id                    String    @id @default(cuid())
  toolName              String
  url                   String
  purposeCategory       String
  accessLevel           String
  authenticationMethod  String
  networkAccess         String // Internal, VPN, Public
  ownerDepartment       String?
  userGroups            String?
  status                String    @default("ACTIVE")
  notes                 String?
  documentationLink     String?
  integrationSystems    String?
  // Common tracking fields
  requestDate           DateTime?
  requestedBy           String?
  approvedBy            String?
  approvalDate          DateTime?
  businessJustification String?
  expiryDate            DateTime?
  accessRequestTicketId String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@map("internal_tools")
}

model VPNNetworkAccess {
  id                    String    @id @default(cuid())
  profileName           String
  vpnType               String
  networkSegments       String // JSON or comma-separated
  accessLevel           String
  deviceRestrictions    String?
  assignedTo            String?
  validFrom             DateTime
  validTo               DateTime?
  status                String    @default("ACTIVE")
  notes                 String?
  ipWhitelist           String?
  splitTunnel           Boolean   @default(false)
  // Common tracking fields
  requestDate           DateTime?
  requestedBy           String?
  approvedBy            String?
  approvalDate          DateTime?
  businessJustification String?
  accessRequestTicketId String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@map("vpn_network_access")
}

model CodeRepository {
  id                    String    @id @default(cuid())
  platform              String // GitHub, GitLab, Bitbucket
  repositoryName        String
  organizationTeam      String
  accessLevel           String // Read, Write, Admin
  branchRestrictions    String?
  assignedTo            String?
  ownerDepartment       String?
  status                String    @default("ACTIVE")
  notes                 String?
  webhookAccess         Boolean   @default(false)
  deploymentKeys        String?
  // Common tracking fields
  requestDate           DateTime?
  requestedBy           String?
  approvedBy            String?
  approvalDate          DateTime?
  businessJustification String?
  expiryDate            DateTime?
  accessRequestTicketId String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@map("code_repositories")
}

model APIKey {
  id                    String    @id @default(cuid())
  serviceName           String
  apiKeyToken           String    @db.Text // Encrypted
  keyType               String // Production, Sandbox, Development
  scopePermissions      String
  rateLimit             String?
  createdDate           DateTime  @default(now())
  expiryDate            DateTime?
  assignedTo            String?
  status                String    @default("ACTIVE")
  notes                 String?
  ipRestrictions        String?
  webhookUrls           String?
  // Common tracking fields
  requestDate           DateTime?
  requestedBy           String?
  approvedBy            String?
  approvalDate          DateTime?
  businessJustification String?
  accessRequestTicketId String?
  updatedAt             DateTime  @updatedAt

  @@map("api_keys")
}

model FileStorage {
  id                    String    @id @default(cuid())
  storageType           String // Network Share, OneDrive, Google Drive
  pathLocation          String
  permissionLevel       String // Read, Write, Full Control
  quotaLimit            String?
  assignedTo            String?
  encryptionStatus      String?
  ownerDepartment       String?
  status                String    @default("ACTIVE")
  notes                 String?
  sharingSettings       String?
  retentionPolicy       String?
  // Common tracking fields
  requestDate           DateTime?
  requestedBy           String?
  approvedBy            String?
  approvalDate          DateTime?
  businessJustification String?
  expiryDate            DateTime?
  accessRequestTicketId String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@map("file_storage")
}

model PhysicalAccess {
  id                    String    @id @default(cuid())
  location              String // Building, Floor, Room
  accessType            String // Badge, Key, Biometric
  badgeCardNumber       String?
  accessSchedule        String
  accessZones           String // JSON or comma-separated
  assignedTo            String?
  validFrom             DateTime
  validTo               DateTime?
  status                String    @default("ACTIVE")
  notes                 String?
  escortRequired        Boolean   @default(false)
  authorizationLevel    String?
  // Common tracking fields
  requestDate           DateTime?
  requestedBy           String?
  approvedBy            String?
  approvalDate          DateTime?
  businessJustification String?
  accessRequestTicketId String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@map("physical_access")
}

// ============================================
// RESOURCE OWNERSHIP & ASSIGNMENT MODELS
// ============================================

model ResourceOwner {
  id              String   @id @default(cuid())
  resourceType    String // DATABASE, SERVER, SOFTWARE_LICENSE, etc.
  resourceId      String // ID of the specific resource
  ownershipType   String // DEPARTMENT, MAIN_OWNER, SECONDARY_OWNER
  ownerId         String? // Department ID or Employee ID
  ownerEmail      String? // For individual owners
  ownerDepartment String? // For department ownership
  notes           String?  @db.Text
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([resourceType, resourceId])
  @@index([ownerEmail])
  @@map("resource_owners")
}

model ResourceAccessRequest {
  id           String @id @default(cuid())
  requestType  String // ACCESS_GRANT, ACCESS_MODIFY, ACCESS_EXTEND, ACCESS_REVOKE
  resourceType String // DATABASE, SERVER, SOFTWARE_LICENSE, etc.
  resourceId   String // ID of the specific resource
  resourceName String // Name for display

  // Requester information
  requesterId         String // Employee ID
  requesterName       String
  requesterEmail      String
  requesterDepartment String?

  // Access details
  accessLevel   String // READ, WRITE, ADMIN, FULL, etc.
  accessDetails Json? // Resource-specific credentials/config

  // Request metadata
  businessJustification String   @db.Text
  accessRequestTicketId String?
  requestedAt           DateTime @default(now())

  // Validity period
  validFrom DateTime?
  validTo   DateTime?

  // Approval workflow
  status            RequestStatus @default(PENDING)
  priority          Priority      @default(MEDIUM)
  currentApproverId String? // Current person who needs to approve

  // Relations
  approvals  ResourceApproval[]
  assignment ResourceAssignment?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([resourceType, resourceId])
  @@index([requesterEmail])
  @@map("resource_access_requests")
}

model ResourceApproval {
  id            String  @id @default(cuid())
  requestId     String
  approverId    String // Employee ID or email
  approverName  String
  approverEmail String
  approverRole  String? // RESOURCE_OWNER, DEPARTMENT_HEAD, IT_ADMIN, etc.

  status    ApprovalStatus @default(PENDING)
  decision  String? // APPROVED, REJECTED, NEEDS_INFO
  comments  String?        @db.Text
  decidedAt DateTime?

  // Relations
  request ResourceAccessRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([requestId])
  @@index([approverEmail])
  @@index([status])
  @@map("resource_approvals")
}

model ResourceAssignment {
  id           String @id @default(cuid())
  requestId    String @unique // Link to original request
  resourceType String // DATABASE, SERVER, SOFTWARE_LICENSE, etc.
  resourceId   String // ID of the specific resource
  resourceName String // Name for display

  // Assignee information
  assigneeId         String // Employee ID
  assigneeName       String
  assigneeEmail      String
  assigneeDepartment String?

  // Access details
  accessLevel       String // READ, WRITE, ADMIN, FULL, etc.
  accessCredentials Json? // Encrypted credentials (username, password, etc.)
  accessDetails     Json? // Resource-specific connection details

  // Access metadata
  grantedBy String // Who approved and granted
  grantedAt DateTime @default(now())

  // Validity period
  validFrom DateTime
  validTo   DateTime?

  // Status
  status   String  @default("ACTIVE") // ACTIVE, EXPIRED, REVOKED, SUSPENDED
  isActive Boolean @default(true)

  // Revocation
  revokedBy        String?
  revokedAt        DateTime?
  revocationReason String?   @db.Text

  // Audit
  lastAccessedAt DateTime?
  accessCount    Int       @default(0)

  // Relations
  request ResourceAccessRequest @relation(fields: [requestId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([resourceType, resourceId])
  @@index([assigneeEmail])
  @@index([status])
  @@index([validTo])
  @@map("resource_assignments")
}

model DepartmentAccessTemplate {
  id           String @id @default(cuid())
  departmentId String
  kind         String // "SYSTEM" | "RESOURCE"

  // kind = SYSTEM
  systemId String?
  system   System? @relation(fields: [systemId], references: [id], onDelete: Cascade)

  // kind = RESOURCE (mirrors the generic resourceType+resourceId pattern already
  // used by ResourceOwner/ResourceAccessRequest/ResourceAssignment)
  resourceType String?
  resourceId   String?
  resourceName String? // denormalized display name, since each of the 12 resource tables names this field differently

  accessLevel String
  isRequired  Boolean  @default(true)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  department Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)

  @@index([departmentId, isActive])
  @@map("department_access_templates")
}

model SystemSettings {
  id String @id @default("settings")

  // General
  companyName String @default("CallPro LLC")
  systemName  String @default("HR Access Control System")
  timezone    String @default("Asia/Ulaanbaatar")
  dateFormat  String @default("MM/DD/YYYY")
  language    String @default("en")
  autoLogout  Int    @default(30)

  // Security
  passwordMinLength   Int     @default(8)
  requireSpecialChars Boolean @default(true)
  requireNumbers      Boolean @default(true)
  requireUppercase    Boolean @default(true)
  sessionTimeout      Int     @default(60)
  twoFactorAuth       Boolean @default(false)
  ipWhitelist         Boolean @default(false)
  auditLogging        Boolean @default(true)

  // Notifications
  emailNotifications Boolean @default(true)
  smsNotifications   Boolean @default(false)
  approvalReminders  Boolean @default(true)
  expiryWarnings     Boolean @default(true)
  securityAlerts     Boolean @default(true)
  systemUpdates      Boolean @default(false)
  reminderDays       Int     @default(7)

  // System
  maxFileSize     Int     @default(10)
  backupFrequency String  @default("daily")
  logRetention    Int     @default(90)
  maintenanceMode Boolean @default(false)
  debugMode       Boolean @default(false)
  apiRateLimit    Int     @default(1000)

  updatedAt DateTime @updatedAt

  @@map("system_settings")
}
